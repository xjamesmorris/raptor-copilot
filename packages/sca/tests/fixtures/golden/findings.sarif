{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "raptor-sca",
          "version": "0.1",
          "informationUri": "https://github.com/gadievron/raptor",
          "rules": [
            {
              "id": "sca:vulnerable_dependency",
              "name": "VulnerableDependency",
              "shortDescription": {
                "text": "A direct or transitive dependency matches a known CVE/GHSA advisory and should be upgraded."
              },
              "fullDescription": {
                "text": "A direct or transitive dependency matches a known CVE/GHSA advisory and should be upgraded."
              },
              "helpUri": "https://github.com/gadievron/raptor",
              "properties": {
                "tags": [
                  "security",
                  "raptor",
                  "vulnerability",
                  "cve"
                ]
              }
            },
            {
              "id": "sca:hygiene:loose_pin",
              "name": "LoosePin",
              "shortDescription": {
                "text": "A dependency uses caret/tilde/range pinning. New patch versions land silently and may introduce vulns the operator ca..."
              },
              "fullDescription": {
                "text": "A dependency uses caret/tilde/range pinning. New patch versions land silently and may introduce vulns the operator can't audit."
              },
              "helpUri": "https://github.com/gadievron/raptor",
              "properties": {
                "tags": [
                  "security",
                  "raptor",
                  "hygiene",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "sca:supply_chain:typosquat_candidate",
              "name": "TyposquatCandidate",
              "shortDescription": {
                "text": "The dependency name is one or two edits away from a popular package and may be a typosquat targeting that package."
              },
              "fullDescription": {
                "text": "The dependency name is one or two edits away from a popular package and may be a typosquat targeting that package."
              },
              "helpUri": "https://github.com/gadievron/raptor",
              "properties": {
                "tags": [
                  "security",
                  "raptor",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "sca:supply_chain:image_capability_drift",
              "name": "sca_supply_chain_image_capability_drift",
              "shortDescription": {
                "text": "RAPTOR /sca finding of type `sca:supply_chain:image_capability_drift`."
              },
              "fullDescription": {
                "text": "RAPTOR /sca finding of type `sca:supply_chain:image_capability_drift`."
              },
              "helpUri": "https://github.com/gadievron/raptor",
              "properties": {
                "tags": [
                  "security",
                  "raptor",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "sca:license:denied",
              "name": "sca_license_denied",
              "shortDescription": {
                "text": "RAPTOR /sca finding of type `sca:license:denied`."
              },
              "fullDescription": {
                "text": "RAPTOR /sca finding of type `sca:license:denied`."
              },
              "helpUri": "https://github.com/gadievron/raptor",
              "properties": {
                "tags": [
                  "security",
                  "raptor"
                ]
              }
            },
            {
              "id": "sca:scan_health:osv_lookup_failed",
              "name": "sca_scan_health_osv_lookup_failed",
              "shortDescription": {
                "text": "RAPTOR /sca finding of type `sca:scan_health:osv_lookup_failed`."
              },
              "fullDescription": {
                "text": "RAPTOR /sca finding of type `sca:scan_health:osv_lookup_failed`."
              },
              "helpUri": "https://github.com/gadievron/raptor",
              "properties": {
                "tags": [
                  "security",
                  "raptor"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "sca:vulnerable_dependency",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "lodash@4.17.20: Command injection in template (CVE-2021-23337) [KEV] [EPSS 0.97]"
          },
          "locations": [
            {
              "physicalLocation": {
