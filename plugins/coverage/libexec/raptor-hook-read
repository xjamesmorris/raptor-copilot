#!/usr/bin/env bash
# PostToolUse(Read) coverage hook — fixed-profile entry shim. Best-effort, async.
set -euo pipefail
umask 077

_diag() { printf 'raptor-hook-read: %s\n' "$1" >&2; }

if [ -z "${CLAUDECODE:-}" ] && [ -z "${_RAPTOR_TRUSTED:-}" ]; then
    _diag "trust marker absent; coverage read not recorded"
    exit 0
fi
command -v python3 >/dev/null 2>&1 || {
    _diag "python3 unavailable; coverage read not recorded"
    exit 0
}

REPO_ROOT=$(
    cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." 2>/dev/null \
        && pwd -P
) || {
    _diag "repository root unavailable; coverage read not recorded"
    exit 0
}
[ -f "$REPO_ROOT/core/coverage/track_read.py" ] || {
    _diag "repository root unavailable; coverage read not recorded"
    exit 0
}
cd -- "$REPO_ROOT" 2>/dev/null || {
    _diag "repository root unavailable; coverage read not recorded"
    exit 0
}

# The shell never reads stdin. Child stdout contains only fixed-template
# diagnostics and becomes this shim's stderr; interpreter text is discarded.
rc=0
python3 -E -s -m core.coverage.track_read 1>&2 2>/dev/null || rc=$?
if [ "$rc" -ne 0 ]; then
    _diag "coverage helper failed (rc=$rc); coverage read not recorded"
fi
exit 0
